{
	"buildCommand": "pnpm run vercel-build",
	"crons": [
		{
			"path": "/api/finra/external-validity",
			"schedule": "0 10 * * *"
		}
	],
	"functions": {
		"src/app/api/**": {
			"maxDuration": 30
		},
		"src/app/api/finra/search/route.ts": {
			"maxDuration": 60
		},
		"src/app/api/finra/sec-search/route.ts": {
			"maxDuration": 60
		},
		"src/app/api/finra/external-validity/route.ts": {
			"maxDuration": 60
		},
		"src/app/api/finra/selection-refresh/route.ts": {
			"maxDuration": 60
		}
	}
}
